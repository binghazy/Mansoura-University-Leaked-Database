# Flask session secret. Use a long random value in production.
SECRET_KEY=

# Public app URL used in admin notification emails.
APP_BASE_URL=http://127.0.0.1:5000

# SMTP settings for request-access notification emails.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_FROM=your_email@gmail.com
# SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
# Optional Vercel/admin login. Set these in Vercel Environment Variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

